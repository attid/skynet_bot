# All variables below can also be provided as Docker Swarm secrets.
# Place the secret value in /run/secrets/<variable_name_lowercase>.
# Priority: env var > .env file > /run/secrets/ > default value.

# --- Telegram Bot ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TEST_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Optional: self-hosted Bot API server (leave empty to use api.telegram.org)
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# --- Databases ---
# Main database (PostgreSQL)
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/skynet_db
# Cache (Redis)
REDIS_URL=redis://localhost:6379/4
# Legacy/Optional
# FIREBIRD_URL=firebird+fdb://SYSDBA:masterkey@127.0.0.1///db/mtl.fdb
# MONGODB_URL=mongodb+srv://mongodb.net/

# --- Stellar Network ---
BASE_FEE=100000 
HORIZON_URL=https://horizon.stellar.org
# Altenative Horizons:
# HORIZON_URL=https://horizon.publicnode.org
# HORIZON_URL=https://horizon.stellar.lobstr.co

# --- External Services ---
OPENAI_KEY=sk-proj-...
OPENROUTER_KEY=sk-or-...

# Crypto Price APIs
CURRENCYLAYER_ID=your_key
COINLAYER_ID=your_key
COINMARKETCAP=your_key
DEBANK=your_key

# Internal tools
EURMTL_KEY=your_key
PRIVATE_SIGN=your_private_key

# Logging (Sentry)
SENTRY_DSN=https://xxx@sentry.io/1
SENTRY_REPORT_DSN=https://xxx@sentry.io/2

# --- Antispam ---
# Combot Anti-Spam (CAS) API key: combot.org -> Settings -> API key (free account works).
# Without it the CAS check is skipped (no error, just one warning in logs).
CAS_API_KEY=
# --- Content Services ---
# New Service for hosting pages (replaces Telegraph)
MINIAPPS_KEY=your_miniapps_key

# Google Grist
GRIST_TOKEN=your_token
# Separate credential for the RELY Grist host (optional unless RELY commands are used)
RELY_GRIST_TOKEN=your_rely_token
# API roots (override only for a compatible deployment)
GRIST_BASE_URL=https://grist.eurmtl.me/api/docs
RELY_GRIST_BASE_URL=https://mtl-rely.getgrist.com/api/docs

# Telegraph (Legacy, required by config reader but replaced in logic)
TELEGRAPH_TOKEN=legacy_token

# --- Stellar Notifier (Webhooks) ---
NOTIFIER_URL=http://operations-notifier:8000
WEBHOOK_PUBLIC_URL=http://skynet_bot:8081/webhook
WEBHOOK_PORT=8081
NOTIFIER_AUTH_TOKEN=your_bearer_token

# --- Pyrogram (Userbot) ---
PYRO_API_ID=12345
PYRO_API_HASH=abcdef1234567890
